# ---------------------------------------------------------------------------
# AA100XTech — example environment configuration (NO REAL SECRETS HERE)
# Copy to .env and fill in real values. Never commit the real .env.
# Only ONE Supabase project may be configured — duplicate SUPABASE_* blocks
# silently override each other and break auth/server functions.
# ---------------------------------------------------------------------------

# --- Database / auth / storage (Lovable Cloud → Supabase) ------------------
# Server-only (read via process.env inside server functions / routes)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="your-project-ref"
# Server-only admin key; configure locally and in Vercel Preview. Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"
# Optional local repair only: personal access token with database_read AND database_write
# permissions for the configured project (Database Read and Read-write in the token form).
# Set in .env.local for npm run repair:influencers -- --apply. Never prefix NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=""

# Browser-visible (must point at the SAME project as the server vars above)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_SUPABASE_PROJECT_ID="your-project-ref"

# --- Affiliate program -----------------------------------------------------
# Shared secret required in the x-api-key header of POST /api/public/v1/conversions
AFFILIATE_API_KEY="generate-a-48-char-random-string"
# Salt used to hash visitor IPs before storage (never store raw IPs)
AFFILIATE_IP_SALT="generate-a-32-char-random-string"
# Optional overrides
AFFILIATE_DEFAULT_COOKIE_DAYS="30"
AFFILIATE_MIN_PAYOUT="1000"

# --- Payments (Razorpay) ---------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_CURRENCY="INR"

# --- ICICI PG Initiate Sale v2 (server-only, UAT only) ----------------------
# For regular npm run dev through ngrok, set this in .env.development.local:
# DEV_TUNNEL_ORIGIN="https://tractor-nautical-snowbird.ngrok-free.dev"
# RPC validates the exact HTTPS forwarding pair; production ignores this setting.
# Keep disabled until ICICI confirms this merchant's UAT setup.
# Production ICICI requests are intentionally unsupported by this adapter.
ICICI_MERCHANT_ID=""
ICICI_AGGREGATOR_ID=""
ICICI_SECRET_KEY=""
ICICI_BASE_URL=""
ICICI_ENVIRONMENT="sandbox"
# Choose exactly one after bank confirmation: sorted-fields OR json-v2.
ICICI_SIGNING_MODE="sorted-fields"
# Registered HTTPS URL, max 128 characters; preserve /api/payments/icici/callback.
# Local UAT: https://<explicit-tunnel-host>/api/payments/icici/callback
# Hosted: https://<matching-staging-or-production-host>/api/payments/icici/callback
# Open the application through that exact HTTPS origin, including any port.
ICICI_RETURN_URL=""
# Development-only alternative: http://localhost:3000/consultation
# Use ICICI_TRUST_PROXY=false and browse http://localhost:3000 for that return URL.
# Default false: ignore forwarding headers; validate request.url's HTTPS origin.
# Set true ONLY behind a trusted HTTPS tunnel/proxy that STRIPS/OVERWRITES incoming
# X-Forwarded-Host and X-Forwarded-Proto with one external host and 'https'.
# Restrict direct access to Next.js (loopback locally; private ingress when hosted).
# Never enable this on a publicly reachable, unprotected Next.js backend.
# Proxy mode requires BOTH headers; no chains, wildcards or HTTP fallback.
ICICI_TRUST_PROXY="false"
ICICI_UAT_ENABLED="false"
ICICI_UAT_MERCHANT_CONFIRMED="true"
# Only set true after the actual bank UAT suite passes; controls customer access.
ICICI_UAT_TESTS_PASSED="false"
# Initial UAT before tests pass: signed-in super admins only, also checked on POST.
ICICI_UAT_TEST_MODE="false"
# Optional local development only: guest testing on DEV_TUNNEL_ORIGIN with trusted proxy.
# Has no effect in production builds; bank verification and UAT gates still apply.
ICICI_UAT_GUEST_CHECKOUT="false"
# GET /api/payments/icici/availability reports safe origins/diagnostics in development.
# The customer option requires completed UAT; test mode permits super admins earlier.
# Browse the same HTTPS UAT origin as ICICI_RETURN_URL; plain localhost will not match.
# See docs/icici-availability.md for diagnosis and activation steps.

# --- Notifications (optional) ----------------------------------------------
RESEND_API_KEY=""
# Approved, provider-verified sender for website inquiries and HR notifications.
NOTIFICATION_FROM_EMAIL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- AI (Lovable AI Gateway) -----------------------------------------------
LOVABLE_API_KEY=""

# --- Existing Supreme Admin operator account -----------------------------
# ADMIN_EMAIL is the legacy server-owned admin allowlist. Passwords below are
# used ONLY by the operator provisioning command, never by public login logic.
# Leave unused account pairs empty. Choose unique passwords of 16+ characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Health check -----------------------------------------------------------
# GET /api/public/v1/health verifies the live database connection.

# --- Per-dashboard admin logins (server-side only) -------------------------
# Preview: npm run admin:provision
# Create missing account / grant role: npm run admin:provision -- --apply --expected-project <confirmed-dev-ref>
# Existing password changes require an explicit extra --reset-password flag.
# Dedicated accounts also require the server-managed Auth role marker this
# command writes. Do not enter placeholder passwords or trust user_metadata.
# Masked input without editing files (Windows, macOS, Linux interactive terminal):
# npm run admin:provision:secure -- --expected-project <confirmed-dev-ref> --apply --reset-password
# process.env > .env.development.local > .env.local > .env.development > .env
SUPER_ADMIN_EMAIL="superadmin@aa100xtech.com"
SUPER_ADMIN_PASSWORD=""
COMPANY_ADMIN_EMAIL="companyadmin@aa100xtech.com"
COMPANY_ADMIN_PASSWORD=""
INTERVIEW_ADMIN_EMAIL="interviewadmin@aa100xtech.com"
INTERVIEW_ADMIN_PASSWORD=""
MARKETING_ADMIN_EMAIL="marketingadmin@aa100xtech.com"
MARKETING_ADMIN_PASSWORD=""
BUSINESS_ADMIN_EMAIL="businessadmin@aa100xtech.com"
BUSINESS_ADMIN_PASSWORD=""
